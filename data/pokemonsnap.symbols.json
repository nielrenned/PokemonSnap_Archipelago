{
  "meta": {
    "endian": "big",
    "addressing": "KSEG0 virtual; physical RDRAM = addr & 0x1FFFFFFF",
    "requires": "8MB Expansion Pak"
  },
  "symbols": {
    "gLevelID": {
      "addr": "0x800AC0C0",
      "type": "s32",
      "access": "r",
      "desc": "Most recently entered level (defaults to -1)"
    },
    "gExpansionMagic": {
      "addr": "0x80400000",
      "type": "u32",
      "access": "r",
      "desc": "0x534E4150 'SNAP' in ROM, becomes 0x4F4B4159 'OKAY' once loaded"
    },
    "gMaxFilm": {
      "addr": "0x80400004",
      "type": "s32",
      "access": "rw",
      "desc": "film cap (below 60)"
    },
    "gCanUseOverride": {
      "addr": "0x80400008",
      "type": "s32",
      "access": "rw",
      "desc": "!=0: all items usable"
    },
    "gCanUseMask": {
      "addr": "0x8040000C",
      "type": "u32",
      "access": "rw",
      "desc": "bit0=apple, 1=pester, 2=flute, 3=dash, 4=sign detector (used when gCanUseOverride==0)"
    },
    "gCourseOverride": {
      "addr": "0x80400010",
      "type": "s32",
      "access": "rw",
      "desc": "!=0: all courses unlocked"
    },
    "gCourseUnlockMask": {
      "addr": "0x80400014",
      "type": "u32",
      "access": "rw",
      "desc": "bit0=Beach,1=Tunnel,2=Volcano,3=Cave,4=River,5=Valley,6=Rainbow (used when gCourseOverride==0)"
    },
    "gDialogFlags": {
      "addr": "0x80400018",
      "type": "u32",
      "access": "rw",
      "desc": "Dialgog flags: bit0=Cloud, 1=Apple, 2=Pester, 3=Flute, 4=6 Pokemon, 5=22 Pokemon, 6=40 Pokemon"
    },
    "apMagic": {
      "addr": "0x8040001C",
      "type": "u32",
      "access": "r",
      "desc": "0x53414431 'SAD1' when the AP block is valid"
    },
    "apChecksum": {
      "addr": "0x80400020",
      "type": "u32",
      "access": "r",
      "desc": "checksum over speciesScores"
    },
    "speciesScores": {
      "addr": "0x80400024",
      "type": "s16[73][6]",
      "access": "r",
      "desc": "[slot][0=special, 1=pose, 2=size, 3=technique, 4=samePkmn, 5=poseFlags]; slot=getSpeciesSlot(pokemonID, levelID)"
    },
    "signsFound": {
      "addr": "0x80400390",
      "type": "u8[6]",
      "access": "r",
      "desc": "[beach, tunnel, volcano, river, cave, valley]"
    },
    "secretExits": {
      "addr": "0x80400396",
      "type": "u8",
      "access": "r",
      "desc": "Bit flags for secret exits taken. bit1=Tunnel,3=River,5=Valley"
    }
  },
  "idents": {
    "auth": {
      "addr": "0x8040041C",
      "rom_offset": "0x0100041C",
      "len": 16,
      "type": "u8[16]",
      "access": "rw",
      "desc": "per-seed auth token; client connects with base64(token)"
    }
  },
  "save": {
    "savePtr": {
      "addr": "0x800C21B0",
      "type": "ptr",
      "access": "r",
      "desc": "pointer to the save struct (deref for base; == saveBase)"
    },
    "saveBase": {
      "addr": "0x800C21C0",
      "type": "UnkBigBoy",
      "access": "r",
      "desc": "main save struct base; full layout in src/more_funcs/more_funcs.h"
    },
    "rank": {
      "addr": "0x800C2224",
      "type": "u32",
      "access": "r",
      "desc": "current rank = (value >> 29) & 7"
    },
    "reportScores": {
      "addr": "0x800C222C",
      "type": "s32[69]",
      "access": "r",
      "desc": "best PKMN Report score per species slot"
    },
    "registeredPhotos": {
      "addr": "0x800C2340",
      "type": "PhotoData[69]",
      "access": "r",
      "desc": "registered photo per species slot (stride 0x3A0); registered if s32 at +0x04 != -1"
    }
  }
}
